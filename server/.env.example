# .env.example -- Copy this file to .env and fill in real values.
# NEVER commit the real .env to version control.

# Port the Express server listens on.
PORT=5000

# The URL of your React frontend (used by the cors package).
# Development:  http://localhost:5173   (Vite default)
# Production:   replace with your deployed frontend URL
CLIENT_ORIGIN=http://localhost:5173